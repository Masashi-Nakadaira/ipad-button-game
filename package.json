{
  "name": "large-button-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:pages": "APP_BASE=ipad-button-game VITE_STATIC_HOST=true vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "test:game": "node --test tests/game.test.mjs tests/audio.test.mjs",
    "test:pwa": "vite build && node --test tests/pwa.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.3.0"
  }
}
